"""
Checagens de qualidade do banco carregado (teste_censo.sqlite).

Uso:
  python checar_dados.py
  python checar_dados.py teste_censo.sqlite violacoes_professores_teste.csv

Nao altera nada: so le o banco. Escreve perfil_colunas.csv ao lado do script.
As consultas usam JOIN ... USING (sintaxe SQLite); no SQL Server troque por ON a.MASCARA = b.MASCARA AND a.ANO = b.ANO.
"""
import os
import re
import sqlite3
import sys

import pandas as pd

pd.set_option("display.width", 230)
pd.set_option("display.max_columns", 40)
pd.set_option("display.max_rows", 200)
pd.set_option("display.max_colwidth", 60)

DB = sys.argv[1] if len(sys.argv) > 1 else "teste_censo.sqlite"
VIOL = sys.argv[2] if len(sys.argv) > 2 else "violacoes_professores_teste.csv"
if not os.path.exists(DB):
    sys.exit(f"Banco nao encontrado: {DB}")
cn = sqlite3.connect(DB)

TABELAS_NUM = ["Infraestrutura", "Turmas", "Alunos_Rendimento", "Matriculas", "Professores"]


def q(sql):
    return pd.read_sql_query(sql, cn)


def titulo(t):
    print("\n" + "=" * 8 + " " + t)


def S(prefixo, cols):
    """COALESCE(p.c1,0)+COALESCE(p.c2,0)+..."""
    return "+".join(f"COALESCE({prefixo}.{c},0)" for c in cols)


# ----------------------------------------------------------------------------------------
titulo("0. Estrutura: o banco tem as colunas da modelagem atual?")
esperadas = {"Alunos_Rendimento": "Medio_alunos_abandono_total", "Matriculas": "Medio_matricula_final_total"}
for tab, col in esperadas.items():
    cols = [r[1] for r in cn.execute(f"PRAGMA table_info({tab})")]
    print(f"  {tab}.{col}: {'ok' if col in cols else 'AUSENTE -> banco gerado com DDL antigo; atualize os arquivos e recarregue'}")

# ----------------------------------------------------------------------------------------
titulo("1. Visao geral")
print(q("SELECT COUNT(*) AS escolas, COUNT(DISTINCT ANO) AS anos, MIN(ANO) AS ano_min, MAX(ANO) AS ano_max, "
        "SUM(CODMUNIC IS NULL) AS sem_municipio FROM Instituicao_Anual").to_string(index=False))
print("\nEscolas por UF:")
print(q("""SELECT e.SIGLA, e.UF, COUNT(DISTINCT m.CODMUNIC) AS municipios, COUNT(*) AS escolas
          FROM Instituicao_Anual a JOIN Municipio m ON m.CODMUNIC = a.CODMUNIC
          JOIN Estadual e ON e.SIGLA = m.SIGLA GROUP BY e.SIGLA, e.UF ORDER BY escolas DESC""").to_string(index=False))
print("\nMunicipios sem nenhuma escola:",
      q("SELECT COUNT(*) AS n FROM Municipio m WHERE NOT EXISTS (SELECT 1 FROM Instituicao_Anual a WHERE a.CODMUNIC = m.CODMUNIC)").n[0])
print("Escolas com REG_CNAS preenchido:",
      q("SELECT SUM(REG_CNAS IS NOT NULL) AS n FROM Instituicao_Imutavel").n[0])

# ----------------------------------------------------------------------------------------
titulo("2. Perfil das colunas numericas (NULL, zero, negativo, valores altos)")
linhas = []
for t in TABELAS_NUM:
    cols = [r[1] for r in cn.execute(f"PRAGMA table_info({t})") if r[1] not in ("MASCARA", "ANO")]
    sel = ", ".join(f'COUNT("{c}"), SUM("{c}" = 0), MIN("{c}"), MAX("{c}"), SUM("{c}" >= 99999)' for c in cols)
    r = cn.execute(f"SELECT COUNT(*), {sel} FROM {t}").fetchone()
    n = r[0]
    for i, c in enumerate(cols):
        nn, z, mn, mx, big = r[1 + 5 * i: 6 + 5 * i]
        linhas.append({"tabela": t, "coluna": c, "pct_nulo": round(100 * (n - nn) / n, 1),
                       "pct_zero": round(100 * (z or 0) / n, 1), "min": mn, "max": mx, "n_ge_99999": big or 0})
perfil = pd.DataFrame(linhas)
perfil.to_csv("perfil_colunas.csv", index=False, encoding="utf-8-sig")


def sinal(l):
    s = []
    if l.pct_nulo == 100: s.append("TODA NULL")
    elif l.pct_nulo > 20: s.append("muito NULL")
    if l.pct_nulo + l.pct_zero >= 99.9 and l.pct_nulo < 100: s.append("tudo zero")
    if l["min"] is not None and l["min"] < 0: s.append("NEGATIVO")
    if l.n_ge_99999 > 0: s.append("valor >= 99999")
    return ", ".join(s)


perfil["alerta"] = perfil.apply(sinal, axis=1)
alertas = perfil[perfil.alerta != ""]
print(f"{len(perfil)} colunas perfiladas (completo em perfil_colunas.csv); {len(alertas)} com alerta:")
print(alertas.to_string(index=False) if len(alertas) else "  nenhuma")
print("\nLeitura: 'TODA NULL' costuma ser coluna que nao existe no arquivo ou numero com formato inesperado (ex.: virgula decimal) "
      "- numeros nao convertiveis viram NULL sem aviso. 'tudo zero' pode ser mapeamento para a coluna errada.")

# ----------------------------------------------------------------------------------------
titulo("3. Dominios")
for tab, col in [("Instituicao_Anual", "DEP"), ("Instituicao_Anual", "LOC"), ("Instituicao_Anual", "CODFUNC")]:
    print(f"\n{col}:")
    print(q(f"SELECT {col} AS valor, COUNT(*) AS escolas FROM {tab} GROUP BY {col} ORDER BY escolas DESC").to_string(index=False))
print("\nFlags de Oferta (1 = SIM, 0 = NAO, NULL = vazio; depende de FLAG_SIM/FLAG_NAO do loader):")
flags = ["NIVELPRE", "NIV_ANOS_INICIAIS", "NIV_F5A8_8", "NIVELMEDIO", "ENSREGULAR", "ENSSUPLET", "ENSESPECIAL"]
res = pd.concat({f: q(f"SELECT {f} AS valor, COUNT(*) AS n FROM Oferta_Ensino GROUP BY {f}").set_index("valor").n for f in flags}, axis=1)
print(res.fillna(0).astype(int).to_string())

# ----------------------------------------------------------------------------------------
titulo("4. Matricula por turno x por sexo (devem fechar, por nivel; so escolas com matricula no nivel)")
NIVEIS = {
    "Pre": ("Pre_diurno", "Pre_noturno", "Pre_masculino", "Pre_feminino"),
    "Anos iniciais": ("Anos_iniciais_diurno", "Anos_iniciais_noturno", "Anos_iniciais_masculino", "Anos_iniciais_feminino"),
    "Anos finais": ("Anos_finais_diurno", "Anos_finais_noturno", "Anos_finais_masculino", "Anos_finais_feminino"),
    "Medio": ("Medio_matriculas_diurno", "Medio_matriculas_noturno", "Medio_masculino", "Medio_feminino"),
}
for nome, (d, n, m, f) in NIVEIS.items():
    turno, sexo = S("m", [d, n]), S("m", [m, f])
    r = q(f"""SELECT COUNT(*) AS escolas, SUM(CASE WHEN {turno} <> {sexo} THEN 1 ELSE 0 END) AS divergentes
              FROM Matriculas m WHERE {turno} + {sexo} > 0""").iloc[0]
    print(f"  {nome:<14} escolas={int(r.escolas):>7}  divergentes={int(r.divergentes or 0):>6}")
    if (r.divergentes or 0) > 0:
        print(q(f"""SELECT MASCARA, {turno} AS por_turno, {sexo} AS por_sexo FROM Matriculas m
                    WHERE {turno} <> {sexo} ORDER BY ABS({turno} - {sexo}) DESC LIMIT 5""").to_string(index=False))

# ----------------------------------------------------------------------------------------
titulo("5. Turmas x Matriculas (turma sem aluno e aluno sem turma)")
PARES = [  # (nome, coluna em Turmas, coluna em Matriculas, multisseriada em Turmas)
    ("Pre diurno", "Pre_diurno", "Pre_diurno", None),
    ("Pre noturno", "Pre_noturno", "Pre_noturno", None),
    ("Anos iniciais diurno", "Anos_iniciais_diurno", "Anos_iniciais_diurno", "Fundamental_multisseriadas_diurno"),
    ("Anos iniciais noturno", "Anos_iniciais_noturno", "Anos_iniciais_noturno", "Fundamental_multisseriadas_noturno"),
    ("Anos finais diurno", "Anos_finais_diurno", "Anos_finais_diurno", "Fundamental_multisseriadas_diurno"),
    ("Anos finais noturno", "Anos_finais_noturno", "Anos_finais_noturno", "Fundamental_multisseriadas_noturno"),
    ("Medio diurno", "Medio_turmas_diurno", "Medio_matriculas_diurno", None),
    ("Medio noturno", "Medio_turmas_noturno", "Medio_matriculas_noturno", None),
]
out = []
for nome, tc, mc, multi in PARES:
    excl = f" AND COALESCE(t.{multi},0) = 0" if multi else ""
    r = q(f"""SELECT SUM(CASE WHEN COALESCE(t.{tc},0) > 0 OR COALESCE(m.{mc},0) > 0 THEN 1 ELSE 0 END) AS escolas,
                     SUM(CASE WHEN COALESCE(t.{tc},0) > 0 AND COALESCE(m.{mc},0) = 0 THEN 1 ELSE 0 END) AS turma_sem_aluno,
                     SUM(CASE WHEN COALESCE(t.{tc},0) = 0 AND COALESCE(m.{mc},0) > 0{excl} THEN 1 ELSE 0 END) AS aluno_sem_turma
              FROM Turmas t JOIN Matriculas m USING (MASCARA, ANO)""").iloc[0]
    out.append({"grupo": nome, **r.to_dict()})
print(pd.DataFrame(out).to_string(index=False))
print("(Em fundamental, aluno sem turma so conta quando a escola nao tem turma multisseriada no turno.)")

# ----------------------------------------------------------------------------------------
titulo("6. Flags de Oferta x dados reais (valida o dominio SIM/NAO escolhido)")
J = "FROM Oferta_Ensino o JOIN Matriculas m USING (MASCARA, ANO) JOIN Alunos_Rendimento a USING (MASCARA, ANO) JOIN Turmas t USING (MASCARA, ANO)"
SUP = ["Supletivo_fundamental_diurno_1sem", "Supletivo_fundamental_diurno_2sem", "Supletivo_medio_diurno_1sem", "Supletivo_medio_diurno_2sem",
       "Supletivo_fundamental_noturno_1sem", "Supletivo_fundamental_noturno_2sem", "Supletivo_medio_noturno_1sem", "Supletivo_medio_noturno_2sem"]
CHECK = {
    "NIVELPRE": S("m", ["Pre_diurno", "Pre_noturno"]),
    "NIV_ANOS_INICIAIS": S("m", ["Anos_iniciais_diurno", "Anos_iniciais_noturno"]),
    "NIV_F5A8_8": S("m", ["Anos_finais_diurno", "Anos_finais_noturno"]),
    "NIVELMEDIO": S("m", ["Medio_matriculas_diurno", "Medio_matriculas_noturno"]),
    "ENSSUPLET": S("a", SUP),
    "ENSESPECIAL": S("a", ["Educacao_especial_alunos_pne_atendimento_total"]) + "+" + S("t", ["Educacao_especial_turmas_pne_total"]),
}
for flag, expr in CHECK.items():
    print(f"\n{flag} x tem_dados:")
    print(q(f"""SELECT o.{flag} AS flag, SUM(CASE WHEN {expr} > 0 THEN 1 ELSE 0 END) AS com_dados,
                       SUM(CASE WHEN {expr} > 0 THEN 0 ELSE 1 END) AS sem_dados {J} GROUP BY o.{flag}""").to_string(index=False))
print("\nLeitura: flag=1 deveria concentrar 'com_dados'. Se flag=0 concentrar 'com_dados', os valores de FLAG_SIM/FLAG_NAO estao invertidos.")

# ----------------------------------------------------------------------------------------
titulo("7. Repetentes nao podem superar a matricula do nivel")
REP = {
    "Anos iniciais": (["Fundamental_anos_iniciais_repetentes_reprovados", "Fundamental_anos_iniciais_repetentes_abandono",
                       "Fundamental_anos_iniciais_repetentes_aprovados"], ["Anos_iniciais_diurno", "Anos_iniciais_noturno"]),
    "Anos finais": (["Fundamental_anos_finais_repetentes_reprovados", "Fundamental_anos_finais_repetentes_abandono",
                     "Fundamental_anos_finais_repetentes_aprovados"], ["Anos_finais_diurno", "Anos_finais_noturno"]),
    "Medio": (["Medio_repetentes_reprovados", "Medio_repetentes_abandono", "Medio_repetentes_aprovados"],
              ["Medio_matriculas_diurno", "Medio_matriculas_noturno"]),
}
for nome, (rep, mat) in REP.items():
    r = q(f"""SELECT SUM(CASE WHEN {S('a', rep)} > 0 THEN 1 ELSE 0 END) AS escolas_com_repetentes,
                     SUM(CASE WHEN {S('a', rep)} > {S('m', mat)} THEN 1 ELSE 0 END) AS repetentes_maior_que_matricula
              FROM Alunos_Rendimento a JOIN Matriculas m USING (MASCARA, ANO)""").iloc[0]
    print(f"  {nome:<14} {r.to_dict()}")

# ----------------------------------------------------------------------------------------
titulo("8. Professores x escola")
TOT = [f"Total_docentes_{x}" for x in ["1grau_incompleto", "1grau_completo", "magisterio", "outra_formacao_medio", "licenciatura_completa",
                                       "superior_sem_licenciatura_com_magisterio", "superior_sem_licenciatura_sem_magisterio"]]
MAT = ["Pre_diurno", "Anos_iniciais_diurno", "Anos_finais_diurno", "Pre_noturno", "Anos_iniciais_noturno", "Anos_finais_noturno",
       "Medio_matriculas_diurno", "Medio_matriculas_noturno"]
print(q(f"""SELECT COUNT(*) AS escolas,
                   SUM(CASE WHEN {S('m', MAT)} > 0 AND {S('p', TOT)} = 0 THEN 1 ELSE 0 END) AS com_alunos_sem_professor,
                   SUM(CASE WHEN {S('m', MAT)} = 0 AND {S('p', TOT)} > 0 THEN 1 ELSE 0 END) AS com_professor_sem_alunos
            FROM Matriculas m JOIN Professores p USING (MASCARA, ANO)""").to_string(index=False))

# ----------------------------------------------------------------------------------------
titulo("9. Valores extremos: 10 maiores escolas por matricula total (turno)")
print(q(f"SELECT MASCARA, {S('m', MAT)} AS matriculas FROM Matriculas m ORDER BY matriculas DESC LIMIT 10").to_string(index=False))

# ----------------------------------------------------------------------------------------
titulo("10. Violacoes das regras 4(a)/4(b) de professores")
if not os.path.exists(VIOL):
    print(f"  arquivo {VIOL} nao encontrado; pulando.")
else:
    v = pd.read_csv(VIOL)
    v["regra_cod"] = v["regra"].str[:2]
    PREF = ["Atuacao_pre_", "Atuacao_anos_iniciais_", "Atuacao_anos_finais_", "Atuacao_medio_", "Atuacao_especial_",
            "Atuacao_supletivo_1sem_", "Atuacao_supletivo_2sem_"]
    def nivel_de(c):
        return next((p.strip("_").replace("Atuacao_", "") for p in PREF if str(c).startswith(p)), "(soma dos niveis)")
    v["nivel_nome"] = v["nivel"].map(nivel_de)
    print(f"{len(v)} violacoes em {v.MASCARA.nunique()} escolas distintas")
    print(v.groupby("regra_cod").agg(violacoes=("MASCARA", "size"), escolas=("MASCARA", "nunique")).to_string())

    a = v[v.regra_cod == "4a"].copy()
    if len(a):
        a["excesso"] = a["atuacao"] - a["total"]
        print("\n4(a) por nivel (concentracao em 'anos_iniciais' indica dupla contagem CA + 1a-4a serie, regra 6):")
        print(a.nivel_nome.value_counts().to_string())
        print("\n4(a) por formacao:")
        print(a.formacao.value_counts().to_string())
        print("\n4(a) tamanho do excesso (atuacao - total da escola):")
        print(a.excesso.describe().round(1).to_string())
        print(f"  excesso de exatamente 1: {(a.excesso == 1).mean():.0%} | ate 2: {(a.excesso <= 2).mean():.0%} | 5 ou mais: {(a.excesso >= 5).mean():.0%}")
        print("\n  Escolas com mais violacoes 4(a):")
        print(a.groupby("MASCARA").size().sort_values(ascending=False).head(10).to_string())

    b = v[v.regra_cod == "4b"].copy()
    if len(b):
        b["falta"] = b["total"] - b["atuacao"]
        print("\n4(b) soma dos niveis menor que o total da escola:")
        print(b.formacao.value_counts().to_string())
        print(f"  escolas em que NENHUM nivel tem professor dessa formacao: {(b.atuacao == 0).sum()} de {len(b)}")
        print(b.falta.describe().round(1).to_string())
        print("  (professor contado no total mas sem nivel de atuacao, ex.: funcao administrativa; e dado a ser investigado.)")

cn.close()
print("\n[fim] checagens concluidas. Perfil completo: perfil_colunas.csv")